# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Data (real data stays local; synthetic is regenerable with `synth --seed`)
data/raw/*
!data/raw/.gitkeep
data/synthetic/*
data/synthetic_calibrated/
!data/synthetic/.gitkeep
data/photos/*
!data/photos/.gitkeep
# New rides / models / reports from the README workflows (raw GPS traces: never commit)
data/new/
models/new/
reports/new/

# Runtime artefacts
*.db
*.sqlite
# models: only the final REAL model is versioned (1.1 MB, scikit-learn pinned in pyproject.toml);
# every other joblib and the synthetic models stay out of git
*.joblib
!models/model.joblib
models/synthetic/

# Secrets
.env
# Demo rides: SYNTHETIC ones are regenerable (see data/demo_rides/README.md)
data/demo_rides/*
!data/demo_rides/.gitkeep
!data/demo_rides/README.md

# Label tool exports saved next to the tool by mistake (real labels live in data/raw/)
web/labels*.csv

# Local DB backups
*.bak
*.bak[0-9]*
*.db.*
